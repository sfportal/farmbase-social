{
  // Cấu hình chạy thử trên máy: D1 cục bộ, không đụng dữ liệu thật.
  "name": "farmbase-social-test",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "farmbase-social-test", "database_id": "local-test", "migrations_dir": "migrations", "migrations_table": "social_migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "farmbase-social-media-test" }],
  "vars": {
    "ADMIN_EMAIL": "admin@example.test",
    "ADMIN_INITIAL_PASSWORD": "MatKhauTam-2026",
    "TOKEN_KEY": "khoa-thu-nghiem-chi-dung-tren-may",
    "FB_APP_ID": "1683859133415974",
    "FB_APP_SECRET": "bi-mat-app-chi-dung-khi-thu",
    "FB_API_VERSION": "v27.0",
    "AI_FAKE_REPLY": "Bài AI viết thử",
    "SOURCES_ALLOW_LOCAL": "1",
    "NEWS_SEARCH_BASE": "http://localhost:8791",
    "FB_GRAPH_BASE": "http://localhost:8791"
  }
}
