{
  // Cloudflare Worker "farmbase-social": giao diện PWA trong public/, API trong src/index.js, CSDL D1 "farmbase-social".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farmbase-social",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Dùng chung D1 "farmbase" với website (gói miễn phí giới hạn 10 D1); mọi bảng có tiền tố social_
      "database_name": "farmbase",
      "database_id": "708142ad-4dfe-46b7-ae7d-b3a0c35f15f5",
      "migrations_dir": "migrations", "migrations_table": "social_migrations"
    }
  ],
  // Kho ảnh, video tải lên cho bài đăng (R2 gói miễn phí 10 GB)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "farmbase-social-media" }],
  // Workers AI: viết bài theo quy định đăng bài (gói miễn phí 10.000 neuron mỗi ngày)
  "ai": { "binding": "AI" },
  "vars": {
    "FB_APP_ID": "1693553165520150",
    "FB_API_VERSION": "v27.0"
  },
  // Biến bí mật đặt trên Cloudflare, không có trong repo: ADMIN_EMAIL, ADMIN_INITIAL_PASSWORD, TOKEN_KEY, FB_APP_SECRET
  // (repo này công khai, nên email và mật khẩu không được ghi ở đây)
  "keep_vars": true,
  "observability": { "enabled": true }
}
